\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Lowest-LCOH allocation misidentifies strategic offshore hydrogen exporters.} \textbf  {a} Country net-export balance under a lowest-LCOH-only baseline and the integrated model in 2030, 2040 and 2050. Blue indicates net export and red indicates net import. Black boxes mark the leading net exporter in each model-year combination. \textbf  {b} Leading net exporter and corresponding net export under the two model structures. \textbf  {c} Residual outside imports identified by the integrated model. The cost-only baseline allocates demand within the modelled European offshore supply by construction and therefore does not expose the residual external import requirement.}}{11}{figure.18}\protected@file@percent }
\newlabel{fig nc lcoh counterfactual}{{6}{11}{\textbf {Lowest-LCOH allocation misidentifies strategic offshore hydrogen exporters.} \textbf {a} Country net-export balance under a lowest-LCOH-only baseline and the integrated model in 2030, 2040 and 2050. Blue indicates net export and red indicates net import. Black boxes mark the leading net exporter in each model-year combination. \textbf {b} Leading net exporter and corresponding net export under the two model structures. \textbf {c} Residual outside imports identified by the integrated model. The cost-only baseline allocates demand within the modelled European offshore supply by construction and therefore does not expose the residual external import requirement}{figure.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}External import prices define a threshold for European offshore supply}{11}{subsection.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Sankey diagram of hydrogen flows and contributions to decarbonization.} \textbf  {a}, \textbf  {c}, and \textbf  {e}, are the Sankey diagrams of hydrogen flows among these countries and international hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents international hydrogen import. Please note that only the hydrogen flows between countries are drawn. The hydrogen supplied by and to itself is not indicated in these figures. \textbf  {b}, \textbf  {d}, and \textbf  {f} show the contributions to the decarbonization of each country by international green hydrogen trading. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions.}}{12}{figure.21}\protected@file@percent }
\newlabel{fig sankey}{{7}{12}{\textbf {Sankey diagram of hydrogen flows and contributions to decarbonization.} \textbf {a}, \textbf {c}, and \textbf {e}, are the Sankey diagrams of hydrogen flows among these countries and international hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents international hydrogen import. Please note that only the hydrogen flows between countries are drawn. The hydrogen supplied by and to itself is not indicated in these figures. \textbf {b}, \textbf {d}, and \textbf {f} show the contributions to the decarbonization of each country by international green hydrogen trading. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions}{figure.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {External import prices define a threshold for European offshore hydrogen supply.} \textbf  {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf  {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan is designed to identify a price threshold, not to assign probabilities to future import prices.}}{13}{figure.24}\protected@file@percent }
\newlabel{fig nc outside option robustness}{{8}{13}{\textbf {External import prices define a threshold for European offshore hydrogen supply.} \textbf {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan is designed to identify a price threshold, not to assign probabilities to future import prices}{figure.24}{}}
