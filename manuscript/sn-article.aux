\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Country rankings for offshore green hydrogen cost competitiveness.} \textbf  {a--c}, Cost-competitiveness metrics for 2030, 2040 and 2050, respectively. Cell numbers report average and marginal LCOH ranks among the 11 countries, and colours show the underlying LCOH values. Marginal LCOH is evaluated at each country's offshore wind capacity target, whereas average LCOH is calculated across the national cost-supply curve. Circles show the hydrogen production capacity with LCOH below the upper bound of the blue-hydrogen benchmark; the smallest and largest circles denote 0 and >100 GW, respectively.}}{7}{figure.10}\protected@file@percent }
\newlabel{fig lcoh rank}{{3}{7}{\textbf {Country rankings for offshore green hydrogen cost competitiveness.} \textbf {a--c}, Cost-competitiveness metrics for 2030, 2040 and 2050, respectively. Cell numbers report average and marginal LCOH ranks among the 11 countries, and colours show the underlying LCOH values. Marginal LCOH is evaluated at each country's offshore wind capacity target, whereas average LCOH is calculated across the national cost-supply curve. Circles show the hydrogen production capacity with LCOH below the upper bound of the blue-hydrogen benchmark; the smallest and largest circles denote 0 and >100 GW, respectively}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Power-system operation under different hydrogen-integration and export cases.} Panels compare model years, seasons, hydrogen blending ratios and export conditions. The labels 2030, 2040 and 2050 denote model years; \textit  {sum} and \textit  {win} denote a typical summer day with high wind and low demand and a typical winter day with low wind and high demand, respectively. The labels 0\%, 20\% and 100\% denote the maximum hydrogen blending ratio in the gas system, and \textit  {ex} denotes the export case. }}{8}{figure.13}\protected@file@percent }
\newlabel{fig unit commitment}{{4}{8}{\textbf {Power-system operation under different hydrogen-integration and export cases.} Panels compare model years, seasons, hydrogen blending ratios and export conditions. The labels 2030, 2040 and 2050 denote model years; \textit {sum} and \textit {win} denote a typical summer day with high wind and low demand and a typical winter day with low wind and high demand, respectively. The labels 0\%, 20\% and 100\% denote the maximum hydrogen blending ratio in the gas system, and \textit {ex} denotes the export case}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Annual offshore wind utilisation and export availability.} \textbf  {a--c}, Offshore wind utilisation in 2030, 2040 and 2050, respectively, decomposed into domestic power-system use, gas-system use, export availability and residual curtailment.}}{9}{figure.15}\protected@file@percent }
\newlabel{fig wind decomposition}{{5}{9}{\textbf {Annual offshore wind utilisation and export availability.} \textbf {a--c}, Offshore wind utilisation in 2030, 2040 and 2050, respectively, decomposed into domestic power-system use, gas-system use, export availability and residual curtailment}{figure.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Carbon emission mitigation potential in Europe}{9}{subsection.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Sankey diagram of hydrogen flows and contributions to decarbonisation} \textbf  {a}, \textbf  {c}, and \textbf  {e}, are the Sankey diagrams of hydrogen flows among these countries and international hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents international hydrogen import. Please note that only the hydrogen flows between countries are drawn. The hydrogen supplied by and to itself is not indicated in these figures. \textbf  {b}, \textbf  {d}, and \textbf  {f} show the contributions to the decarbonisation of each country by international green hydrogen trading. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions.}}{10}{figure.18}\protected@file@percent }
\newlabel{fig sankey}{{6}{10}{\textbf {Sankey diagram of hydrogen flows and contributions to decarbonisation} \textbf {a}, \textbf {c}, and \textbf {e}, are the Sankey diagrams of hydrogen flows among these countries and international hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents international hydrogen import. Please note that only the hydrogen flows between countries are drawn. The hydrogen supplied by and to itself is not indicated in these figures. \textbf {b}, \textbf {d}, and \textbf {f} show the contributions to the decarbonisation of each country by international green hydrogen trading. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions}{figure.18}{}}
