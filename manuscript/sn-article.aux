\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {A lowest-LCOH allocation misidentifies strategic offshore hydrogen exporters.} \textbf  {a} Country net-export balance under a lowest-LCOH-only baseline and the integrated model in 2030, 2040 and 2050. Blue indicates net export and red indicates net import. Black boxes mark the leading net exporter in each model-year combination. \textbf  {b} Leading net exporter and corresponding net export under the two model structures. \textbf  {c} Residual outside imports identified by the integrated model. The cost-only baseline allocates demand within the modelled European offshore supply by construction and therefore does not expose the residual external import requirement.}}{12}{figure.21}\protected@file@percent }
\newlabel{fig nc lcoh counterfactual}{{7}{12}{\textbf {A lowest-LCOH allocation misidentifies strategic offshore hydrogen exporters.} \textbf {a} Country net-export balance under a lowest-LCOH-only baseline and the integrated model in 2030, 2040 and 2050. Blue indicates net export and red indicates net import. Black boxes mark the leading net exporter in each model-year combination. \textbf {b} Leading net exporter and corresponding net export under the two model structures. \textbf {c} Residual outside imports identified by the integrated model. The cost-only baseline allocates demand within the modelled European offshore supply by construction and therefore does not expose the residual external import requirement}{figure.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}External import prices define a threshold for European offshore supply}{12}{subsection.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {External import prices define the boundary of European offshore hydrogen supply.} \textbf  {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf  {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan identifies a delivered-price threshold rather than assigning probabilities to future import prices.}}{13}{figure.24}\protected@file@percent }
\newlabel{fig nc outside option robustness}{{8}{13}{\textbf {External import prices define the boundary of European offshore hydrogen supply.} \textbf {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan identifies a delivered-price threshold rather than assigning probabilities to future import prices}{figure.24}{}}
