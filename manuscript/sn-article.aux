\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Sankey diagram of hydrogen flows and contributions to carbon mitigation.} \textbf  {a}, \textbf  {c}, and \textbf  {e}, are the Sankey diagrams of hydrogen flows among these countries and external hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents external import. Only the hydrogen flows between countries are drawn; hydrogen supplied and consumed within the same country is not shown. \textbf  {b}, \textbf  {d}, and \textbf  {f} show supplier-attributed carbon mitigation in the optimized supply mix, including domestic self-supply and exports. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions. ITN contributions are excluded when reporting European offshore supplier contributions.}}{22}{figure.19}\protected@file@percent }
\newlabel{fig sankey}{{6}{22}{\textbf {Sankey diagram of hydrogen flows and contributions to carbon mitigation.} \textbf {a}, \textbf {c}, and \textbf {e}, are the Sankey diagrams of hydrogen flows among these countries and external hydrogen imports in 2030, 2040, and 2050, respectively. ITN represents external import. Only the hydrogen flows between countries are drawn; hydrogen supplied and consumed within the same country is not shown. \textbf {b}, \textbf {d}, and \textbf {f} show supplier-attributed carbon mitigation in the optimized supply mix, including domestic self-supply and exports. Different bars represent the reduction in carbon dioxide emissions, and different colours indicate different countries' contributions. ITN contributions are excluded when reporting European offshore supplier contributions}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {External import prices define a threshold for European offshore hydrogen supply.} \textbf  {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf  {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan is designed to identify a price threshold, not to assign probabilities to future import prices.}}{23}{figure.22}\protected@file@percent }
\newlabel{fig nc outside option robustness}{{7}{23}{\textbf {External import prices define a threshold for European offshore hydrogen supply.} \textbf {a} 2050 supply mix between external low-carbon imports and European offshore hydrogen under delivered outside-option prices from 2 to 6 EUR kg$^{-1}$ H$_2$-equivalent. \textbf {b} Net-export response of Ireland, the United Kingdom and Denmark under the same price scan. Blue indicates net export and red indicates net import. The scan is designed to identify a price threshold, not to assign probabilities to future import prices}{figure.22}{}}
