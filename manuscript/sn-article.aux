\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Export access reduces domestic wind curtailment in the Ireland power-gas case.} \textbf  {a} Mean wind-curtailment rates across representative summer and winter periods in 2030, 2040 and 2050, with and without export access. \textbf  {b} Decomposition of available wind energy in the 2050 summer representative period. Export access converts otherwise curtailed wind into energy used by the power system, but residual curtailment remains because operating constraints still bind at the margin.}}{6}{figure.11}\protected@file@percent }
\newlabel{fig unit commitment}{{3}{6}{\textbf {Export access reduces domestic wind curtailment in the Ireland power-gas case.} \textbf {a} Mean wind-curtailment rates across representative summer and winter periods in 2030, 2040 and 2050, with and without export access. \textbf {b} Decomposition of available wind energy in the 2050 summer representative period. Export access converts otherwise curtailed wind into energy used by the power system, but residual curtailment remains because operating constraints still bind at the margin}{figure.11}{}}
