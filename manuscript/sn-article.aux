\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Atlantic wind quality does not by itself determine the lowest offshore hydrogen cost.} \textbf  {a} Gridded LCOH surfaces in the EEZs of the studied coastal European countries, with country labels marking the national offshore resource areas. \textbf  {b} Country-level wind-speed probability densities. The vertical grey line in each density plot marks the modal wind speed. BE, DK, FR, DE, IE, NL, NO, PT, ES, SE and GB denote Belgium, Denmark, France, Germany, Ireland, the Netherlands, Norway, Portugal, Spain, Sweden and the United Kingdom, respectively.}}{4}{figure.6}\protected@file@percent }
\newlabel{fig LCOH map}{{1}{4}{\textbf {Atlantic wind quality does not by itself determine the lowest offshore hydrogen cost.} \textbf {a} Gridded LCOH surfaces in the EEZs of the studied coastal European countries, with country labels marking the national offshore resource areas. \textbf {b} Country-level wind-speed probability densities. The vertical grey line in each density plot marks the modal wind speed. BE, DK, FR, DE, IE, NL, NO, PT, ES, SE and GB denote Belgium, Denmark, France, Germany, Ireland, the Netherlands, Norway, Portugal, Spain, Sweden and the United Kingdom, respectively}{figure.6}{}}
