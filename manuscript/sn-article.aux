\citation{BritainsHydrogenNetworkPlan}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cost-supply curves show widening offshore hydrogen competitiveness but do not rank strategic exporters.} \textbf  {a--c}, Green-hydrogen cost-supply curves for 2030, 2040 and 2050, respectively. Coloured lines highlight Denmark, Ireland, the Netherlands and the UK; grey lines show the other studied countries. Coloured markers denote Ireland's and the UK's offshore wind capacity targets on their corresponding supply curves. Grey bands show the assumed future blue-hydrogen production-price range.}}{5}{figure.8}\protected@file@percent }
\newlabel{fig LCOH curve}{{2}{5}{\textbf {Cost-supply curves show widening offshore hydrogen competitiveness but do not rank strategic exporters.} \textbf {a--c}, Green-hydrogen cost-supply curves for 2030, 2040 and 2050, respectively. Coloured lines highlight Denmark, Ireland, the Netherlands and the UK; grey lines show the other studied countries. Coloured markers denote Ireland's and the UK's offshore wind capacity targets on their corresponding supply curves. Grey bands show the assumed future blue-hydrogen production-price range}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Different cost metrics produce different country rankings for offshore green hydrogen.} Rank indicates the average or marginal LCOH rank among the 11 studied countries. Marginal means the LCOH at the policy-constrained offshore capacity of that country in the corresponding year. Average means the capacity-weighted average LCOH across the offshore capacity in the corresponding year. Low-price hydrogen means the hydrogen production capacity with production cost below the upper bound of blue hydrogen. Circle size indicates low-price hydrogen capacity, with the smallest and largest circles representing 0 and $>$100 GW, respectively.}}{6}{figure.10}\protected@file@percent }
\newlabel{fig lcoh rank}{{3}{6}{\textbf {Different cost metrics produce different country rankings for offshore green hydrogen.} Rank indicates the average or marginal LCOH rank among the 11 studied countries. Marginal means the LCOH at the policy-constrained offshore capacity of that country in the corresponding year. Average means the capacity-weighted average LCOH across the offshore capacity in the corresponding year. Low-price hydrogen means the hydrogen production capacity with production cost below the upper bound of blue hydrogen. Circle size indicates low-price hydrogen capacity, with the smallest and largest circles representing 0 and $>$100 GW, respectively}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Export access converts otherwise curtailed offshore wind into usable hydrogen output.} Panels compare representative 72-hour summer (sum) and winter (win) periods in 2030, 2040 and 2050. The first two rows show cases without export access, and the last two rows show otherwise matched cases with export access (ex). Coloured areas show interconnector power and generation by technology, with offshore wind and curtailed offshore wind separated from other generation. Black lines show the offshore wind curtailment rate on the right axis. The 0\%, 20\% and 100\% labels denote the allowed hydrogen share in the gas network, with 100\% representing pure-hydrogen network operation.}}{7}{figure.13}\protected@file@percent }
\newlabel{fig unit commitment}{{4}{7}{\textbf {Export access converts otherwise curtailed offshore wind into usable hydrogen output.} Panels compare representative 72-hour summer (sum) and winter (win) periods in 2030, 2040 and 2050. The first two rows show cases without export access, and the last two rows show otherwise matched cases with export access (ex). Coloured areas show interconnector power and generation by technology, with offshore wind and curtailed offshore wind separated from other generation. Black lines show the offshore wind curtailment rate on the right axis. The 0\%, 20\% and 100\% labels denote the allowed hydrogen share in the gas network, with 100\% representing pure-hydrogen network operation}{figure.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Integrated trade reallocates carbon-mitigation value across Europe}{7}{subsection.16}\protected@file@percent }
\citation{COemissions}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Domestic power-gas absorption leaves uneven exportable surplus across Europe.} \textbf  {a--c}, Decomposition of annual offshore wind use across the 11 studied countries in 2030, 2040 and 2050. Each circular stack separates wind used by the power system, wind used by the gas system, wind available for export or otherwise curtailed, and residual wind curtailed anyway. Radial values are in TWh yr$^{-1}$. Country abbreviations follow Fig. \ref {fig LCOH map}. The UK remains the largest available-surplus system, while Ireland becomes the second-largest by 2050 despite not being a lowest-LCOH country.}}{8}{figure.15}\protected@file@percent }
\newlabel{fig wind decomposition}{{5}{8}{\textbf {Domestic power-gas absorption leaves uneven exportable surplus across Europe.} \textbf {a--c}, Decomposition of annual offshore wind use across the 11 studied countries in 2030, 2040 and 2050. Each circular stack separates wind used by the power system, wind used by the gas system, wind available for export or otherwise curtailed, and residual wind curtailed anyway. Radial values are in TWh yr$^{-1}$. Country abbreviations follow Fig. \ref {fig LCOH map}. The UK remains the largest available-surplus system, while Ireland becomes the second-largest by 2050 despite not being a lowest-LCOH country}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Integrated hydrogen and ammonia trade reallocates carbon-mitigation value across Europe.} \textbf  {a}, \textbf  {c} and \textbf  {e}, Cross-border hydrogen-equivalent flows and external imports in 2030, 2040 and 2050, respectively. ITN denotes external imports; within-country self-supply is omitted from the flow panels. \textbf  {b}, \textbf  {d} and \textbf  {f}, Supplier-attributed carbon mitigation, including domestic self-supply and exports. Bar colours identify the contributing supplier. ITN is included in plotted totals but excluded from European offshore supplier contributions reported in the text.}}{10}{figure.18}\protected@file@percent }
\newlabel{fig sankey}{{6}{10}{\textbf {Integrated hydrogen and ammonia trade reallocates carbon-mitigation value across Europe.} \textbf {a}, \textbf {c} and \textbf {e}, Cross-border hydrogen-equivalent flows and external imports in 2030, 2040 and 2050, respectively. ITN denotes external imports; within-country self-supply is omitted from the flow panels. \textbf {b}, \textbf {d} and \textbf {f}, Supplier-attributed carbon mitigation, including domestic self-supply and exports. Bar colours identify the contributing supplier. ITN is included in plotted totals but excluded from European offshore supplier contributions reported in the text}{figure.18}{}}
